<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your Ticket - {{eventTitle}}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
      background-color: #f5f5f5;
    }
    .container {
      max-width: 600px;
      margin: 20px auto;
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 40px 30px;
      text-align: center;
    }
    .header h1 {
      margin: 0 0 10px 0;
      font-size: 32px;
      font-weight: 700;
    }
    .header p {
      margin: 0;
      font-size: 16px;
      opacity: 0.95;
    }
    .content {
      padding: 40px 30px;
    }
    .greeting {
      font-size: 18px;
      margin-bottom: 20px;
    }
    .event-banner {
      background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
      border-left: 4px solid #667eea;
      padding: 20px;
      margin: 30px 0;
      border-radius: 8px;
    }
    .event-title {
      font-size: 24px;
      font-weight: 700;
      color: #667eea;
      margin: 0 0 15px 0;
    }
    .info-grid {
      display: table;
      width: 100%;
    }
    .info-row {
      display: table-row;
    }
    .info-label {
      display: table-cell;
      padding: 8px 15px 8px 0;
      font-weight: 600;
      color: #666;
      width: 40%;
    }
    .info-value {
      display: table-cell;
      padding: 8px 0;
      color: #333;
    }
    .ticket-code-box {
      text-align: center;
      margin: 30px 0;
      padding: 25px;
      background: #f8f9fa;
      border-radius: 8px;
      border: 2px dashed #667eea;
    }
    .ticket-code-label {
      font-size: 14px;
      color: #666;
      margin-bottom: 8px;
    }
    .ticket-code {
      font-size: 32px;
      font-weight: 700;
      color: #667eea;
      letter-spacing: 3px;
      font-family: 'Courier New', monospace;
    }
    .cta-button {
      display: block;
      width: 100%;
      max-width: 300px;
      margin: 30px auto;
      padding: 16px 32px;
      background: #667eea;
      color: white !important;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 16px;
      text-align: center;
      box-shadow: 0 4px 6px rgba(102, 126, 234, 0.3);
      transition: all 0.3s;
    }
    .cta-button:hover {
      background: #5568d3;
      box-shadow: 0 6px 8px rgba(102, 126, 234, 0.4);
    }
    .warning-box {
      background: #fff3cd;
      border: 1px solid #ffc107;
      border-radius: 8px;
      padding: 20px;
      margin: 30px 0;
    }
    .warning-box h3 {
      margin: 0 0 12px 0;
      color: #856404;
      font-size: 16px;
    }
    .warning-box ul {
      margin: 0;
      padding-left: 20px;
      color: #856404;
    }
    .warning-box li {
      margin: 8px 0;
    }
    .footer {
      background: #f8f9fa;
      padding: 30px;
      text-align: center;
      color: #666;
      font-size: 14px;
      border-top: 1px solid #e9ecef;
    }
    .footer p {
      margin: 8px 0;
    }
    .divider {
      height: 1px;
      background: #e9ecef;
      margin: 30px 0;
    }
    @media only screen and (max-width: 600px) {
      .container {
        margin: 0;
        border-radius: 0;
      }
      .content {
        padding: 30px 20px;
      }
      .header {
        padding: 30px 20px;
      }
      .ticket-code {
        font-size: 24px;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header -->
    <div class="header">
      <h1>🎟️ Your Ticket is Ready!</h1>
      <p>Thank you for choosing TicketHub</p>
    </div>
    
    <!-- Content -->
    <div class="content">
      <div class="greeting">
        Hi <strong>{{userName}}</strong>,
      </div>
      
      <p>Great news! Your ticket has been confirmed and is ready to use. Here are your ticket details:</p>
      
      <!-- Event Banner -->
      <div class="event-banner">
        <div class="event-title">{{eventTitle}}</div>
        <div class="info-grid">
          <div class="info-row">
            <div class="info-label">📅 Date & Time:</div>
            <div class="info-value">{{eventDate}}</div>
          </div>
          <div class="info-row">
            <div class="info-label">📍 Location:</div>
            <div class="info-value">{{eventLocation}}</div>
          </div>
          <div class="info-row">
            <div class="info-label">🎫 Ticket Type:</div>
            <div class="info-value">{{ticketType}}</div>
          </div>
          <div class="info-row">
            <div class="info-label">🔢 Quantity:</div>
            <div class="info-value">{{quantity}}</div>
          </div>
          <div class="info-row">
            <div class="info-label">💰 Total Price:</div>
            <div class="info-value">{{totalPrice}} VNĐ</div>
          </div>
        </div>
      </div>

      <!-- Ticket Code -->
      <div class="ticket-code-box">
        <div class="ticket-code-label">Your Ticket Code</div>
        <div class="ticket-code">{{ticketCode}}</div>
      </div>

      <!-- CTA Button -->
      <a href="{{viewTicketUrl}}" class="cta-button">
        📱 View Ticket & QR Code
      </a>

      <!-- Warning Box -->
      <div class="warning-box">
        <h3>⚠️ Important Information</h3>
        <ul>
          <li>Click the button above to view your ticket with QR code</li>
          <li>Show the QR code at the event entrance for check-in</li>
          <li>Each ticket can only be used once</li>
          <li>Keep this email safe - you'll need it to access your ticket</li>
          <li>Arrive early to avoid queues at the entrance</li>
        </ul>
      </div>

      <div class="divider"></div>

      <p style="text-align: center; color: #666;">
        Questions? Contact us at <a href="mailto:support@tickethub.com" style="color: #667eea;">support@tickethub.com</a>
      </p>
    </div>

    <!-- Footer -->
    <div class="footer">
      <p><strong>TicketHub</strong></p>
      <p>This is an automated email. Please do not reply to this message.</p>
      <p>&copy; {{year}} TicketHub. All rights reserved.</p>
    </div>
  </div>
</body>
</html>
